{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyno-io.github.io/rtc-session-gateway/contracts/endpoint-catalog-v2.schema.json",
  "title": "RTC native endpoint catalog v2",
  "description": "Public endpoint-file contract for direct sipbridge and rtpbridge connections. Any deployment-owned publisher may supply it. IDs within each section must be unique. Consumers validate URL host/port and verify peer names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signaling",
    "media"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "signaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "validUntil",
        "backends"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "backends": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "acceptNew",
              "control"
            ],
            "properties": {
              "id": {
                "description": "Must equal the sipbridge instance ID returned by the native hello.",
                "type": "string",
                "pattern": "^[a-zA-Z0-9._:-]{1,127}$"
              },
              "acceptNew": {
                "type": "boolean"
              },
              "control": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "tlsServerName"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^wss://[^/?#@]+/v1/control$"
                  },
                  "tlsServerName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[A-Za-z0-9.:-]+$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "validUntil",
        "backends"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "backends": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "acceptNew",
              "control"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9._:-]{1,127}$"
              },
              "acceptNew": {
                "type": "boolean"
              },
              "control": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^wss://[^/?#@]+/$"
                  },
                  "tlsServerName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[A-Za-z0-9.:-]+$"
                  }
                }
              },
              "recordings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://[^/?#@]+/$"
                  },
                  "tlsServerName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[A-Za-z0-9.:-]+$"
                  }
                }
              },
              "turn": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "urls"
                ],
                "properties": {
                  "urls": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 1024,
                      "pattern": "^(?:stun|turn|turns):[^/@#]+$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
